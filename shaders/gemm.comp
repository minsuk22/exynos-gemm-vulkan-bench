#version 450
#extension GL_EXT_control_flow_attributes : require

//
// Single-source SGEMM kernel: C[MxN] = A[MxK] * B[KxN]  (row-major, fp32)
//
// The four benchmark variants are produced from this one file by toggling
// USE_SHARED_A / USE_SHARED_B at SPIR-V compile time. The loop structure,
// tiling and register blocking are IDENTICAL in all four variants, so the
// only thing being measured is whether the A / B operand is staged through
// workgroup shared memory (LDS) or re-read from global memory every step.
//
//   USE_SHARED_A=0 USE_SHARED_B=0  ->  "none"      (no shared memory at all)
//   USE_SHARED_A=1 USE_SHARED_B=0  ->  "shared_a"  (A tiled in LDS, B global)
//   USE_SHARED_A=0 USE_SHARED_B=1  ->  "shared_b"  (B tiled in LDS, A global)
//   USE_SHARED_A=1 USE_SHARED_B=1  ->  "shared_ab" (both tiled in LDS)
//

#ifndef TS
#define TS 16          // workgroup is TS x TS invocations
#endif
#ifndef TM
#define TM 4           // rows of C computed per invocation
#endif
#ifndef TN
#define TN 4           // cols of C computed per invocation
#endif
#ifndef BK
#define BK 16          // depth of one K-tile
#endif

#define BM (TS * TM)   // rows of C per workgroup  (64)
#define BN (TS * TN)   // cols of C per workgroup  (64)
#define NTHREADS (TS * TS)

#ifndef USE_SHARED_A
#define USE_SHARED_A 0
#endif
#ifndef USE_SHARED_B
#define USE_SHARED_B 0
#endif

// Storage order of A. B and C are always row-major.
//   row-major : element (m,k) at A[m*K + k], leading dimension K
//   col-major : element (m,k) at A[k*M + m], leading dimension M
//               i.e. the host uploads A transposed
//
// Column-major makes the m direction contiguous, which is the direction the
// inner loop walks: regA[0..TM-1] becomes one contiguous run instead of TM
// separate cache lines K floats apart, and the LDS staging store lands on
// consecutive words instead of needing a transpose.
#ifndef A_COL_MAJOR
#define A_COL_MAJOR 0
#endif

#if A_COL_MAJOR
#define A_AT(m, k) A[(k) * p.M + (m)]
#else
#define A_AT(m, k) A[(m) * p.K + (k)]
#endif

#define USE_LDS (USE_SHARED_A || USE_SHARED_B)

layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint M;
    uint N;
    uint K;
} p;

layout(std430, binding = 0) readonly  buffer BufA { float A[]; };
layout(std430, binding = 1) readonly  buffer BufB { float B[]; };
layout(std430, binding = 2) writeonly buffer BufC { float C[]; };

#if USE_SHARED_A
// Held as As[k][m] so the inner loop broadcasts across a subgroup. From a
// row-major A the staging store transposes, and consecutive invocations would
// all land on one bank; the pad breaks that up. A column-major A already
// stores to consecutive words, so it needs no pad.
#if A_COL_MAJOR
#define AS_PAD 0
#else
#define AS_PAD 4
#endif
shared float As[BK][BM + AS_PAD];
#endif
#if USE_SHARED_B
shared float Bs[BK][BN];
#endif

void main()
{
    const uint tid       = gl_LocalInvocationID.y * TS + gl_LocalInvocationID.x;
    const uint blockRow  = gl_WorkGroupID.y * BM;
    const uint blockCol  = gl_WorkGroupID.x * BN;
    const uint threadRow = gl_LocalInvocationID.y * TM;   // offset inside the block tile
    const uint threadCol = gl_LocalInvocationID.x * TN;

    // Global row/col of this invocation's first output element.
    const uint gRow = blockRow + threadRow;
    const uint gCol = blockCol + threadCol;

    float acc[TM][TN];
    [[unroll]] for (int i = 0; i < TM; ++i)
        [[unroll]] for (int j = 0; j < TN; ++j)
            acc[i][j] = 0.0;

    float regA[TM];
    float regB[TN];

    for (uint kt = 0; kt < p.K; kt += BK) {
#if USE_LDS
        barrier();   // previous iteration must be done reading the tiles
#endif

#if USE_SHARED_A
        // BK*BM elements over NTHREADS invocations. idx is decomposed so that
        // consecutive invocations read consecutive addresses of A whichever way
        // A is stored: along k when row-major, along m when column-major.
        [[unroll]] for (uint idx = tid; idx < BK * BM; idx += NTHREADS) {
#if A_COL_MAJOR
            uint kk = idx / BM;
            uint mm = idx - kk * BM;
#else
            uint mm = idx / BK;
            uint kk = idx - mm * BK;
#endif
            As[kk][mm] = A_AT(blockRow + mm, kt + kk);
        }
#endif
#if USE_SHARED_B
        // Consecutive invocations read consecutive columns of B (coalesced)
        // and write consecutive LDS addresses (conflict free).
        [[unroll]] for (uint idx = tid; idx < BK * BN; idx += NTHREADS) {
            uint kk = idx / BN;
            uint nn = idx - kk * BN;
            Bs[kk][nn] = B[(kt + kk) * p.N + blockCol + nn];
        }
#endif

#if USE_LDS
        barrier();
#endif

        [[unroll]] for (uint kk = 0; kk < BK; ++kk) {
            [[unroll]] for (int i = 0; i < TM; ++i) {
#if USE_SHARED_A
                regA[i] = As[kk][threadRow + i];
#else
                regA[i] = A_AT(gRow + i, kt + kk);
#endif
            }
            [[unroll]] for (int j = 0; j < TN; ++j) {
#if USE_SHARED_B
                regB[j] = Bs[kk][threadCol + j];
#else
                regB[j] = B[(kt + kk) * p.N + gCol + j];
#endif
            }
            [[unroll]] for (int i = 0; i < TM; ++i)
                [[unroll]] for (int j = 0; j < TN; ++j)
                    acc[i][j] = fma(regA[i], regB[j], acc[i][j]);
        }
    }

    // The dispatch grid is rounded up, because a block tile need not divide the
    // matrix -- TM=6 gives BM=96, which never divides a power-of-two size. The
    // loads above are allowed to run past M/N into the buffers' allocated slack
    // (harmless: those results are discarded), so only the store is guarded.
    // This sits outside the k loop, one predicate per output element against
    // K*TM*TN fused multiply-adds, and is identical in all four variants.
    [[unroll]] for (uint i = 0; i < TM; ++i) {
        if (gRow + i >= p.M) continue;
        [[unroll]] for (uint j = 0; j < TN; ++j) {
            if (gCol + j < p.N)
                C[(gRow + i) * p.N + gCol + j] = acc[i][j];
        }
    }
}
