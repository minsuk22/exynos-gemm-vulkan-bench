#version 450
#extension GL_EXT_control_flow_attributes : require

//
// Single-source SGEMM kernel: C[MxN] = A[MxK] * B[KxN]  (fp32)
//
// Every benchmark variant is produced from this one file by toggling defines at
// SPIR-V compile time. Everything not being toggled -- tiling, register
// blocking, loop order, FMA order -- stays identical, so a measured difference
// is attributable to the toggled axis alone.
//
//   USE_SHARED_A / USE_SHARED_B   operand staging
//     0 / 0  ->  "none"       (no shared memory at all)
//     1 / 0  ->  "shared_a"   (A tiled in LDS, B from global)
//     0 / 1  ->  "shared_b"   (B tiled in LDS, A from global)
//     1 / 1  ->  "shared_ab"  (both tiled in LDS)
//
//   A_COL_MAJOR    storage order of A (B and C are always row-major)
//   TM / TN        micro-tile computed per invocation
//   DOUBLE_BUFFER  ping-pong the LDS tiles (only meaningful with USE_LDS)
//

#ifndef TS
#define TS 16          // workgroup is TS x TS invocations
#endif
#ifndef TM
#define TM 4           // rows of C computed per invocation
#endif
#ifndef TN
#define TN 4           // cols of C computed per invocation
#endif
#ifndef BK
#define BK 16          // depth of one K-tile
#endif

#define BM (TS * TM)   // rows of C per workgroup
#define BN (TS * TN)   // cols of C per workgroup
#define NTHREADS (TS * TS)

#ifndef USE_SHARED_A
#define USE_SHARED_A 0
#endif
#ifndef USE_SHARED_B
#define USE_SHARED_B 0
#endif
#ifndef DOUBLE_BUFFER
#define DOUBLE_BUFFER 0
#endif

#define USE_LDS (USE_SHARED_A || USE_SHARED_B)
// Double buffering is a property of the LDS staging; with no LDS there is
// nothing to ping-pong and the flag collapses to the plain path.
#define DB (DOUBLE_BUFFER && USE_LDS)

// Storage order of A.
//   row-major : element (m,k) at A[m*K + k], leading dimension K
//   col-major : element (m,k) at A[k*M + m], leading dimension M
//               i.e. the host uploads A transposed
//
// Column-major makes the m direction contiguous, which is the direction the
// inner loop walks: regA[0..TM-1] becomes one contiguous run instead of TM
// separate cache lines K floats apart, and the LDS staging store lands on
// consecutive words instead of needing a transpose.
#ifndef A_COL_MAJOR
#define A_COL_MAJOR 0
#endif

#if A_COL_MAJOR
#define A_AT(m, k) A[(k) * p.M + (m)]
#else
#define A_AT(m, k) A[(m) * p.K + (k)]
#endif

layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(push_constant) uniform Params {
    uint M;
    uint N;
    uint K;
} p;

layout(std430, binding = 0) readonly  buffer BufA { float A[]; };
layout(std430, binding = 1) readonly  buffer BufB { float B[]; };
layout(std430, binding = 2) writeonly buffer BufC { float C[]; };

// --- LDS tiles --------------------------------------------------------------
//
// Held as [k][m] / [k][n] so the inner loop broadcasts across a subgroup. From
// a row-major A the staging store transposes and consecutive invocations would
// all land on one bank; the pad breaks that up. A column-major A already
// stores to consecutive words, so it needs no pad.
#if A_COL_MAJOR
#define AS_PAD 0
#else
#define AS_PAD 4
#endif

#if DB
#  if USE_SHARED_A
shared float As[2][BK][BM + AS_PAD];
#  endif
#  if USE_SHARED_B
shared float Bs[2][BK][BN];
#  endif
#  define AS(buf, k, m) As[buf][k][m]
#  define BS(buf, k, n) Bs[buf][k][n]
#else
#  if USE_SHARED_A
shared float As[BK][BM + AS_PAD];
#  endif
#  if USE_SHARED_B
shared float Bs[BK][BN];
#  endif
#  define AS(buf, k, m) As[k][m]
#  define BS(buf, k, n) Bs[k][n]
#endif

// Tile-load index decomposition. idx is laid out so consecutive invocations
// touch consecutive addresses of the operand: along k for a row-major A, along
// m for a column-major A, along n for B.
#if A_COL_MAJOR
#define A_DECOMP(idx) uint kk = (idx) / BM; uint mm = (idx) - kk * BM;
#else
#define A_DECOMP(idx) uint mm = (idx) / BK; uint kk = (idx) - mm * BK;
#endif
#define B_DECOMP(idx) uint kk = (idx) / BN; uint nn = (idx) - kk * BN;

// A tile is BK*BM elements over NTHREADS invocations; both divide exactly for
// every tile size built here, so these are the per-invocation load counts.
#define A_LOADS ((BK * BM) / NTHREADS)
#define B_LOADS ((BK * BN) / NTHREADS)

void main()
{
    const uint tid       = gl_LocalInvocationID.y * TS + gl_LocalInvocationID.x;
    const uint blockRow  = gl_WorkGroupID.y * BM;
    const uint blockCol  = gl_WorkGroupID.x * BN;
    const uint threadRow = gl_LocalInvocationID.y * TM;   // offset inside the block tile
    const uint threadCol = gl_LocalInvocationID.x * TN;

    // Global row/col of this invocation's first output element.
    const uint gRow = blockRow + threadRow;
    const uint gCol = blockCol + threadCol;

    float acc[TM][TN];
    [[unroll]] for (int i = 0; i < TM; ++i)
        [[unroll]] for (int j = 0; j < TN; ++j)
            acc[i][j] = 0.0;

    float regA[TM];
    float regB[TN];

// --- staging macros ---------------------------------------------------------
// Written once and used by both the prologue and the loop body, so the two can
// never drift apart.

#if USE_SHARED_A
#define LOAD_A_TO_LDS(BUF, KT)                                                 \
    [[unroll]] for (uint q = 0; q < A_LOADS; ++q) {                            \
        uint idx = tid + q * NTHREADS;                                         \
        A_DECOMP(idx)                                                          \
        AS(BUF, kk, mm) = A_AT(blockRow + mm, (KT) + kk);                      \
    }
#define PREFETCH_A(KT)                                                         \
    [[unroll]] for (uint q = 0; q < A_LOADS; ++q) {                            \
        uint idx = tid + q * NTHREADS;                                         \
        A_DECOMP(idx)                                                          \
        preA[q] = A_AT(blockRow + mm, (KT) + kk);                              \
    }
#define STORE_A(BUF)                                                           \
    [[unroll]] for (uint q = 0; q < A_LOADS; ++q) {                            \
        uint idx = tid + q * NTHREADS;                                         \
        A_DECOMP(idx)                                                          \
        AS(BUF, kk, mm) = preA[q];                                             \
    }
#else
#define LOAD_A_TO_LDS(BUF, KT)
#define PREFETCH_A(KT)
#define STORE_A(BUF)
#endif

#if USE_SHARED_B
#define LOAD_B_TO_LDS(BUF, KT)                                                 \
    [[unroll]] for (uint q = 0; q < B_LOADS; ++q) {                            \
        uint idx = tid + q * NTHREADS;                                         \
        B_DECOMP(idx)                                                          \
        BS(BUF, kk, nn) = B[((KT) + kk) * p.N + blockCol + nn];                \
    }
#define PREFETCH_B(KT)                                                         \
    [[unroll]] for (uint q = 0; q < B_LOADS; ++q) {                            \
        uint idx = tid + q * NTHREADS;                                         \
        B_DECOMP(idx)                                                          \
        preB[q] = B[((KT) + kk) * p.N + blockCol + nn];                        \
    }
#define STORE_B(BUF)                                                           \
    [[unroll]] for (uint q = 0; q < B_LOADS; ++q) {                            \
        uint idx = tid + q * NTHREADS;                                         \
        B_DECOMP(idx)                                                          \
        BS(BUF, kk, nn) = preB[q];                                             \
    }
#else
#define LOAD_B_TO_LDS(BUF, KT)
#define PREFETCH_B(KT)
#define STORE_B(BUF)
#endif

#if USE_SHARED_A
#define GET_A(BUF, KT, KK, I) AS(BUF, KK, threadRow + (I))
#else
#define GET_A(BUF, KT, KK, I) A_AT(gRow + (I), (KT) + (KK))
#endif
#if USE_SHARED_B
#define GET_B(BUF, KT, KK, J) BS(BUF, KK, threadCol + (J))
#else
#define GET_B(BUF, KT, KK, J) B[((KT) + (KK)) * p.N + gCol + (J)]
#endif

#define COMPUTE_TILE(BUF, KT)                                                  \
    [[unroll]] for (uint kk = 0; kk < BK; ++kk) {                              \
        [[unroll]] for (int i = 0; i < TM; ++i)                                \
            regA[i] = GET_A(BUF, KT, kk, i);                                   \
        [[unroll]] for (int j = 0; j < TN; ++j)                                \
            regB[j] = GET_B(BUF, KT, kk, j);                                   \
        [[unroll]] for (int i = 0; i < TM; ++i)                                \
            [[unroll]] for (int j = 0; j < TN; ++j)                            \
                acc[i][j] = fma(regA[i], regB[j], acc[i][j]);                  \
    }

// --- main loop --------------------------------------------------------------

#if DB
    // Ping-pong the LDS tiles. Tile kt is read out of buffer `cur` while tile
    // kt+BK is fetched from global into registers and written to buffer cur^1.
    // The two never alias, so one barrier per iteration suffices instead of
    // two: it both publishes the writes to cur^1 and confirms every invocation
    // has finished reading cur, which the iteration after next will overwrite.
#  if USE_SHARED_A
    float preA[A_LOADS];
#  endif
#  if USE_SHARED_B
    float preB[B_LOADS];
#  endif

    LOAD_A_TO_LDS(0, 0)
    LOAD_B_TO_LDS(0, 0)
    barrier();

    uint cur = 0;
    for (uint kt = 0; kt < p.K; kt += BK) {
        // Uniform across the workgroup, so the barrier below stays in uniform
        // control flow.
        bool hasNext = (kt + BK) < p.K;

        // Issued before the FMAs so the global latency overlaps with compute.
        if (hasNext) {
            PREFETCH_A(kt + BK)
            PREFETCH_B(kt + BK)
        }

        COMPUTE_TILE(cur, kt)

        if (hasNext) {
            STORE_A(cur ^ 1)
            STORE_B(cur ^ 1)
        }
        barrier();
        cur ^= 1;
    }
#else
    const uint cur = 0;
    for (uint kt = 0; kt < p.K; kt += BK) {
#  if USE_LDS
        barrier();   // previous iteration must be done reading the tiles
#  endif
        LOAD_A_TO_LDS(cur, kt)
        LOAD_B_TO_LDS(cur, kt)
#  if USE_LDS
        barrier();
#  endif
        COMPUTE_TILE(cur, kt)
    }
#endif

    // The dispatch grid is rounded up, because a block tile need not divide the
    // matrix -- TM=6 gives BM=96, which never divides a power-of-two size. The
    // loads above are allowed to run past M/N into the buffers' allocated slack
    // (harmless: those results are discarded), so only the store is guarded.
    // This sits outside the k loop, one predicate per output element against
    // K*TM*TN fused multiply-adds, and is identical in all variants.
    [[unroll]] for (uint i = 0; i < TM; ++i) {
        if (gRow + i >= p.M) continue;
        [[unroll]] for (uint j = 0; j < TN; ++j) {
            if (gCol + j < p.N)
                C[(gRow + i) * p.N + gCol + j] = acc[i][j];
        }
    }
}
